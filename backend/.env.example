PORT=8000
NODE_ENV=development
MONGODB_URL=
JWT_SECRET=
JWT_EXPIRE=7d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-2603

# Password reset emails (nodemailer / SMTP).
# Leave SMTP_* blank in development and the reset link is printed to the server
# console instead of being emailed. In production these are required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CodeDojo <no-reply@example.com>"
# Base URL of the frontend, used to build the reset link in the email
FRONTEND_URL=http://localhost:5173
